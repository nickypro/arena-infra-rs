# arena-infra-rs example config. Copy to config.env and fill in.
# Run `arena --config ./config.env config check` to validate.
# NOTE: config.env is git-ignored; never commit real keys.

# ---- Provider credentials (set the one(s) you use) ----
RUNPOD_API_KEY="rpa_xxxxxxxxxxxxxxxxxxxxxxxx"
# Which RunPod REST API to use: "v2" (api.runpod.io/v2) is the default when this is unset
# or empty. "v1" (rest.runpod.io/v1) still works until RunPod RETIRES it on 2026-11-16,
# after which every RunPod call fails; `config check` warns while it's set. v1 can't ask
# for a host on CUDA newer than 13.0 (so it often finds "no capacity"), and v2's restart
# resets the container disk (see VOLUME_GB below). Anything else is an error. Can also be
# set per run from the environment without editing this file (`RUNPOD_API=v1 arena pods
# list`); `config check` shows which one is in effect.
# RUNPOD_API="v1"
# VAST_API_KEY="xxxxxxxx"
# Vast rents verified hosts only; 1 also admits unverified/deverified ones (flakier, but
# the verified market for a card can be empty). Anything but 1/true/yes/0/false/no is an error.
# VAST_ALLOW_UNVERIFIED=1
# HETZNER_API_KEY="xxxxxxxx"

# ---- Create spec ----
# Provider-neutral keys are preferred; the RUNPOD_* names are accepted as
# fallback so older configs keep working. Set whichever you like.
GPU_TYPE="NVIDIA RTX A4000"          # or RUNPOD_GPU_TYPE
NUM_GPUS=1                            # or RUNPOD_NUM_GPUS
IMAGE="nickypro/arena-env:9.1"      # or RUNPOD_DOCKER_IMAGE
MIN_CUDA_VERSION="13.0"               # lowest host CUDA (9.1 image needs 13.0): any NEWER host qualifies too
# ALLOWED_CUDA_VERSIONS (or RUNPOD_ALLOWED_CUDA_VERSIONS) is read the same way: a FLOOR, its
# lowest version (it used to be RunPod's exact match, which made every newer host — e.g. all
# B300 MIG hosts on 13.2 — "no capacity"). RunPod v2 sends it as minCudaVersion; REST v1 has
# no floor and sends its schema's versions >= it (up to 13.0 only — remove RUNPOD_API=v1 for newer).
# EXACT_CUDA_VERSIONS="13.0,13.1"     # opt-in exact set (RunPod allowedCudaVersions); wins over the floor
CLOUD_TYPE="COMMUNITY"               # or RUNPOD_CLOUD_TYPE ("COMMUNITY"|"SECURE")
DISK_GB=100                          # or RUNPOD_DISK_SPACE_IN_GB
VOLUME_GB=0                          # or RUNPOD_VOLUME_SPACE_IN_GB
                                     # ^ 0 = NO persistent volume: work is lost on
                                     #   pod restart (RunPod v2, the default, resets the
                                     #   container to its image). Set non-zero to keep work.
# Near the proxy: create/up (and offers, replace/migrate) try options in this region first —
# every participant's SSH goes through the proxy box, and a far pod adds its round trip to
# every keystroke. RunPod: SECURE pods only, pinned to EU-…/EUR-… data centres (COMMUNITY hosts
# have none); Vast: offers by country. Unset = europe; "north-america"; "any" (or empty) = off.
# NEAR="europe"
# A near option is preferred while it costs at most this many percent more than the cheapest
# acceptable option (default 25). Both can come from the environment for one run (NEAR=any …).
# NEAR_MAX_EXTRA_PCT=25
# Extra fields deep-merged into every create request (`pods create`/`up`, where --api-json
# merges over it; the TUI's add-pod form; replace/migrate copy) — API options with no flag,
# for the provider that creates. ONE JSON object in SINGLE quotes. Fields arena sets itself
# (name, image, GPU, tier, disk, SSH keys, 22/tcp, templates…) are refused.
# CREATE_EXTRA_JSON='{"dataCenterIds": ["EU-RO-1"]}'

# ---- Hetzner (CPU-only VMs); ignored by GPU providers ----
# HETZNER_SERVER_TYPE="cx23"    # default; `pods create/up --server-type` overrides it per run
# HETZNER_IMAGE="ubuntu-24.04"  # or "arena": the newest arena-built snapshot in this project that fits
#                               # the server type (`arena image build` makes one; setup then takes
#                               # ~1 min, not ~10), else ubuntu-24.04; or a snapshot id.
#                               # `pods create/up --image` overrides it per run
# VM_SWAP_GB=8                  # swap file setup makes on a bare VM (Hetzner, Shadeform); 0 = none, max 64
# HETZNER_LOCATION="any"       # default: any location that sells the type, nearest to this machine
#                               # first, the next when one has no room; "nbg1" pins one, "nbg1,fsn1"
#                               # orders them
# HETZNER_SSH_KEY="my-hetzner-key-name"   # a key already uploaded to the project
#                                         # (default: the one named after MACHINE_NAME_PREFIX)

# ---- Shadeform (opt-in overflow GPU VMs: `--provider shadeform`) ----
# Plain GPU VMs from many clouds behind one API. A VM BILLS UNTIL TERMINATED (no stop, no
# volumes); what Shadeform does at a $0 wallet is undocumented — keep Auto Top Up on.
# SHADEFORM_API_KEY="xxxxxxxx"           # admin-scoped (Shadeform has no read-only keys)
# SHADEFORM_CLOUDS="massedcompute"       # allowlist of underlying clouds; "*" = any (warned)
# SHADEFORM_REGIONS=""                   # optional allowlist of region ids
# SHADEFORM_MAX_PRICE="1.00"             # hard $/h per pod ceiling under any --max-price
# SHADEFORM_SSH_KEY="arena8"             # the uploaded cohort key's NAME (default: the prefix);
#                                        # "default" = the account default (Shadeform holds its
#                                        # private half — avoid)
# SHADEFORM_MAX_BOOT_SECS=1200           # skip catalog entries that may boot slower
# SHADEFORM_READY_MINS=15                # create → up with SSH, per attempt; else deleted, next option
# SHADEFORM_ALLOW_BAREMETAL=0            # 1 = also bare-metal entries
# A live test's backstop: Shadeform deletes the VM itself after a time or a spend, e.g.
# --api-json '{"auto_delete": {"date_threshold": "2026-10-20T15:00:00Z", "spend_threshold": "1.50"}}'

# ---- Machine naming ----
MACHINE_NAME_PREFIX="arena8"
# Fully-qualified names are {prefix}-{name}, drawn in order, skipping taken ones. These are the
# original arena-infra's 55. A name's place in the list is its proxy port
# (SSH_PROXY_STARTING_PORT + index): once pods exist, add new names at the end, never in between.
MACHINE_NAME_LIST=(
    "apple" "autumn" "bloom" "bonbon" "bulk" "cloud" "coco" "derpy" "diamond" "discord"
    "ember" "entropy" "flash" "flutter" "gabby" "gustav" "harmony" "iron" "ivy" "jack" "joy"
    "keepsake" "kind" "knowledge" "lightning" "luna" "lyra" "marble" "mayor" "moon" "nova"
    "nurse" "octavia" "orchard" "photo" "pink" "queen" "quiet" "rainbow" "rarity" "scoot"
    "shining" "silver" "spike" "spitfire" "starlight" "sunset" "trouble" "twilight" "unity"
    "vinyl" "wild" "wish" "yarn" "zebra"
)

# ---- SSH (used by `backup` and the dashboard metrics) ----
SSH_USER="root"
SHARED_SSH_KEY_PATH="/root/.ssh/arena8_key"

# ---- Proxy / port-forwarding (`proxy plan`) ----
SSH_PROXY_USER="root"
SSH_PROXY_HOST="proxy.example.com"          # the stable public host
SSH_PROXY_NGINX_CONFIG_PATH="~/proxy.conf"
SSH_PROXY_STARTING_PORT=7000                 # machine index 0 -> this port
# Run after `proxy apply` writes the config. Absent -> "nginx -t && nginx -s reload".
# Set it EMPTY (SSH_PROXY_RELOAD_CMD="") for write-only: the file is written, nginx is
# never reloaded (e.g. a sandbox sharing a box with the production nginx). It can also be
# forced empty from the environment (`export SSH_PROXY_RELOAD_CMD=` in a wrapper) even
# when this file lacks it. A failed reload puts the previous config back (next sync retries).
# SSH_PROXY_RELOAD_CMD="sudo nginx -t && sudo nginx -s reload"

# ---- Your own ~/.ssh/config (`arena ssh-config --install`) ----
# Kept current after every pod change, `pods list` and each dashboard refresh: the proxy's
# ports when SSH_PROXY_HOST is set, else each pod's endpoint. Only a file arena wrote (its first
# line says so) is ever rewritten. Unset: nothing is written. For your own machine: leave it
# unset on a box running arena's cron lines (each tick would rewrite that user's file).
# SSH_CONFIG_FILE="~/.ssh/arena.conf"

# ---- Backup (`arena backup`) ----
ARENA_REPO_NAME="ARENA_materials"            # repo on the pod -> /root/<name>
# The public course repo `pods setup` adds as each checkout's `upstream` remote (https; only
# when it has none), for `git pull upstream main`. Default ARENA-education/ARENA_materials;
# `none` adds none.
# ARENA_UPSTREAM_REPO="ARENA-education/ARENA_materials"
# Backup branch is autocommit-{prefix}-w{week}d{day}-{machine}; week/day computed from
# this start date (start date itself = w0d1, day 8 = w1d1) — usually the Monday the
# program starts. Override per-run with --week/--day. Can also be set via the env
# (`ARENA_START_DATE=... arena backup`) or baked into cron (`arena cron install
# --start-date 2026-05-25`) without editing this file.
ARENA_START_DATE="2026-05-25"
# BACKUP_REPO_PATH="/root/ARENA_materials"     # override the path explicitly
# BACKUP_BRANCH_PREFIX="backup"              # pushes to {prefix}/{machine}
GIT_SSH_KEY_REMOTE="/root/.ssh/id_ed25519"   # key on the pod for `git push`
# The most `pods set-branch --hard` copies, on the pod, of the untracked or ignored files and
# directories its reset removes (into .git/arena-discarded/<time>/untracked/), in GiB (binary,
# as `du` counts: sizes are said in GiB/MiB/KiB), a fraction too (`0.5`). More than this, or more
# than half what's free on the pod's disk there: that pod isn't reset, and its line says what was
# too big and how to move it out of the way. Unset = 1 (the save runs within the switch's 100 s on
# the pod). Can be set from the env for one run, even when this file lacks it
# (`DISCARD_MAX_GB=0.001 arena pods set-branch main <pod> --hard`); `config check` then says so.
# DISCARD_MAX_GB=1
# Wall-clock budget (seconds) for each pod's rsync in `pods pull` / `pods backup` (the file
# step): a pod that runs over is stopped and named as failed while the others finish (rsync
# also gives up after 5 min with no I/O). Unset = 7200 (2 h); at most 86400. Can be set
# from the env for one run (`BACKUP_TIMEOUT_SECS=14400 arena pods pull`).
# BACKUP_TIMEOUT_SECS=7200
# A pod whose backup finds an operation in progress — a conflicted `git pull` (a merge), a
# cherry-pick, a revert, a `git stash pop`'s conflicts — isn't committed (BUSY): `pods backup`
# copies it by rsync instead (again only once its files change, or hourly). Left alone this many
# hours (the operation, every file git lists, the index, any terminal; no git command or editor
# on git's message running), `pods backup` finishes it: each conflicted file from the side whose
# last change to it is newer — per hunk for text, so both sides' other changes stay — a file
# resolved by hand kept as it is (one begun by hand, or maybe begun, leaves it as it is), the state before kept in
# .git/arena-resolved/ first; then backs the pod up. Unsaved editor buffers can't be seen. Whole
# hours, 1..720; unset = 3; 0 or off = never. Never a revert, a `git am`, a rebase or a sequence.
# BUSY_AUTO_RESOLVE_HOURS=3

# ---- Provisioning (`arena pods setup`, `pods up`) ----
# Per-pod budget (seconds) for the main setup command; a pod that runs over reports
# "timed out at <step>" while the rest carry on. Unset = 300 for image-based pods and
# 1800 for the hetzner bare-VM script; when set it applies to BOTH (so keep it >= ~1800
# if you provision hetzner VMs). `pods setup --timeout N` overrides it per run.
# SETUP_TIMEOUT_SECS=600
# VS Code Remote-SSH warm-up (last setup step, best-effort, its own 300s budget): the
# latest stable VS Code server + these extensions into ~/.vscode-server, and the conda
# env (CONDA_ENV) as python.defaultInterpreterPath unless one is set. 0 = off
# (`pods setup --no-vscode` skips it for one run). Extensions: comma-separated
# marketplace ids, or "none"; unset = Python, Pylance, Jupyter.
# VSCODE_PREINSTALL=1
# VSCODE_EXTENSIONS="ms-python.python,ms-python.vscode-pylance,ms-toolsai.jupyter"
# Repo on the volume (image-based pods with a /workspace volume, VOLUME_GB>0): setup moves
# BACKUP_REPO_PATH onto /workspace and links it, so a restart/stop keeps the work (its own
# best-effort step, 900s). 0 = off: the repo stays on the container disk, and after a reset
# a volume copy from earlier isn't linked back.
# REPO_ON_VOLUME=1

# ---- Backup archive (optional, `arena archive …`) ----
# An always-on Hetzner VM with two volumes that keeps copy #2 of LOCAL_BACKUP_DIR (dated
# snapshots + all files), pushed by `arena cron install --archive`, readable by participants
# over sftp once you run `arena archive access on`. Its state (keys, pin) lives in
# $ARENA_STATE_DIR/<prefix>/archive/ — set ARENA_STATE_DIR here so root's cron and your shell
# share it, and back that directory up.
# ARCHIVE_HETZNER_API_KEY="xxxxxxxx"   # its own Hetzner project (recommended); else HETZNER_API_KEY
# ARCHIVE_LOCATION="nbg1"              # default: HETZNER_LOCATION's first named location, else nbg1
# ARCHIVE_SERVER_TYPES="cx23,cax11"    # tried in order when one can't be placed
# ARCHIVE_SNAP_GB=50                   # volume sizes at creation (grow later: `archive resize`)
# ARCHIVE_BIG_GB=200
# ARCHIVE_KEEP_UNTIL="2027-01-31"      # retention date: messages + `teardown --check` only; nothing auto-deletes
# ARCHIVE_HOST="archive.example.org"   # a DNS name for participants' configs (default: its IP)
# ARCHIVE_BWLIMIT="10M"                # rsync --bwlimit on every push; 0 = none
# ARCHIVE_SNAP_TIMEOUT_SECS=900        # wall-clock budget per snapshot label / for the big push
# ARCHIVE_BIG_TIMEOUT_SECS=7200
# ARCHIVE_EXTRA_EXCLUDES="*.key,secrets/"   # added to the built-in secret list (never shortens it)
# LOCAL_BACKUP_DIR must be ABSOLUTE for `cron install --archive`.

# ---- Remote execution (`arena pods run` / `pods test`) ----
# Commands run inside an interactive shell with this conda env activated, so they see
# the participants' python/packages. Set empty ("") to skip activation (still sources
# the shell rc so HF_TOKEN/CLAUDE_CODE_OAUTH_TOKEN are present).
# CONDA_ENV="arena-env"
# `pods test --deep` fails pods whose NVIDIA driver is below this. Unset = derived from the
# CUDA floor above (13.x -> 580, 12.8 -> 570, ...); "none" = no driver check.
# MIN_DRIVER_VERSION=580

# ---- Money (optional) ----
# `arena balance`, the `pods list` footer, the create/up preflight and the TUI call a prepaid
# account (RunPod, Vast) low (⚠) when it would run out within this many hours at the current
# burn; under 24 h it is critical (‼). 0 = no runway levels (≤ $0 and RunPod's underBalance
# stay critical). A bad value falls back to 72 (`arena balance` says so; `config check` fails).
# BALANCE_WARN_HOURS=72
# A running pod nobody priced (RunPod v1's REST list has no $/h; after GraphQL nothing fills
# it in) is counted at the last price seen for it, else — a known GPU — the most it is known
# to cost (RunPod's recorded catalog, the presets, live catalog/offer prices seen), else — an
# unknown GPU type (a MIG slice of one, whatever comes next) — this ceiling in USD per
# GPU-hour: above the dearest recorded catalog price (B300 secure $7.89), so the burn errs
# high and the runway short. A bad value falls back to 8 (`config check` fails on it).
# BALANCE_UNPRICED_PER_GPU=8

# ---- Dashboard (optional) ----
# A remote command whose stdout is shown as each pod's "progress" in the TUI.
# PROGRESS_CMD="cat /root/progress.txt"

# ---- Asking an AI about pods (`arena pods ask`, the TUI's `?`) ----
# Which AI answers: "claude" (the default; Claude Code's `claude`, on your login — the pods'
# state goes to Anthropic) or "codex" (OpenAI's `codex`); `--ai` picks per run. "off" turns
# both off: `pods ask` and `?` refuse, whatever --ai says, and nothing goes to an AI service.
# Anything else is an error (`config check` fails on it). What is sent: docs/REFERENCE.md
# "`pods ask`".
# ASK_AI=claude
# Each AI's model and effort (low, medium, high, xhigh or max); unset is its CLI's own. A small
# model at low effort answers in seconds — the dashboard's Tab switches between the two:
# ASK_CLAUDE_MODEL=sonnet
# ASK_CLAUDE_EFFORT=low
# ASK_CODEX_MODEL=gpt-6-luna
# ASK_CODEX_EFFORT=low
