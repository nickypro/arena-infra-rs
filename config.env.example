# arena-infra-rs example config. Copy to config.env and fill in.
# Run `arena --config ./config.env config check` to validate.
# NOTE: config.env is git-ignored; never commit real keys.

# ---- Provider credentials (set the one(s) you use) ----
RUNPOD_API_KEY="rpa_xxxxxxxxxxxxxxxxxxxxxxxx"
# VAST_API_KEY="xxxxxxxx"
# HETZNER_API_KEY="xxxxxxxx"

# ---- Create spec ----
# Provider-neutral keys are preferred; the RUNPOD_* names are accepted as
# fallback so older configs keep working. Set whichever you like.
GPU_TYPE="NVIDIA RTX A4000"          # or RUNPOD_GPU_TYPE
NUM_GPUS=1                            # or RUNPOD_NUM_GPUS
IMAGE="arenainfo/arena-env:7.3"      # or RUNPOD_DOCKER_IMAGE
CLOUD_TYPE="COMMUNITY"               # or RUNPOD_CLOUD_TYPE ("COMMUNITY"|"SECURE")
DISK_GB=100                          # or RUNPOD_DISK_SPACE_IN_GB
VOLUME_GB=0                          # or RUNPOD_VOLUME_SPACE_IN_GB
                                     # ^ 0 = NO persistent volume: work is lost on
                                     #   pod restart. Set non-zero to keep work.

# ---- Hetzner (CPU-only VMs); ignored by GPU providers ----
# HETZNER_SERVER_TYPE="cx22"
# HETZNER_IMAGE="ubuntu-24.04"
# HETZNER_LOCATION="nbg1"
# HETZNER_SSH_KEY="my-hetzner-key-name"   # a key already uploaded to the project

# ---- Machine naming ----
MACHINE_NAME_PREFIX="arena8"
# Fully-qualified names are {prefix}-{name}, drawn in order, skipping taken ones.
MACHINE_NAME_LIST=(
    "apple"
    "autumn"
    "bloom"
)

# ---- SSH (used by `backup` and the dashboard metrics) ----
SSH_USER="root"
SHARED_SSH_KEY_PATH="/root/.ssh/arena8_key"

# ---- Proxy / port-forwarding (`proxy plan`) ----
SSH_PROXY_USER="root"
SSH_PROXY_HOST="proxy.example.com"          # the stable public host
SSH_PROXY_NGINX_CONFIG_PATH="~/proxy.conf"
SSH_PROXY_STARTING_PORT=7000                 # machine index 0 -> this port

# ---- Backup (`arena backup`) ----
ARENA_REPO_NAME="ARENA_3.0"                  # repo on the pod -> /root/<name>
# Backup branch is autocommit-{prefix}-w{week}d{day}-{machine}; week/day computed from
# this start date (start date itself = w0d1, day 8 = w1d1) — usually the Monday the
# program starts. Override per-run with --week/--day. Can also be set via the env
# (`ARENA_START_DATE=... arena backup`) or baked into cron (`arena cron install
# --start-date 2026-05-25`) without editing this file.
ARENA_START_DATE="2026-05-25"
# BACKUP_REPO_PATH="/root/ARENA_3.0"         # override the path explicitly
# BACKUP_BRANCH_PREFIX="backup"              # pushes to {prefix}/{machine}
GIT_SSH_KEY_REMOTE="/root/.ssh/id_ed25519"   # key on the pod for `git push`

# ---- Dashboard (optional) ----
# A remote command whose stdout is shown as each pod's "progress" in the TUI.
# PROGRESS_CMD="cat /root/progress.txt"
